#include <windows.h>
0xc3 DIALOGEX 0, 0, 120, 40
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Reminder or feature message"
BEGIN
    LTEXT "Test", -1, 5, 5, 100, 10
END
0x13bf DIALOGEX 0, 0, 120, 40
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Offer"
BEGIN
    LTEXT "Test", -1, 5, 5, 100, 10
END
0xc9 DIALOGEX 0, 0, 120, 40
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Other dialog"
BEGIN
    LTEXT "Test", -1, 5, 5, 100, 10
END
STRINGTABLE
BEGIN
    0x291 "Reminder"
    0x1ce "Feature unavailable"
END
1 VERSIONINFO
FILEVERSION 1,2,3,4
PRODUCTVERSION 1,2,3,4
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "NoNag test resources"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
